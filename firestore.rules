rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'stats']) &&
             data.keys().size() >= 3 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.stats is map &&
             data.stats.easy is int &&
             data.stats.medium is int &&
             data.stats.hard is int &&
             data.stats.mixed is int &&
             data.stats.dailyStreak is int;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Users cannot list all profiles
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'displayName', 'photoURL'])
      );
    }

    // Game Logs
    function isValidGameLog(data) {
      return data.keys().hasAll(['userId', 'score', 'difficulty', 'mode', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.score is int &&
             data.difficulty in ['easy', 'medium', 'hard', 'mixed'] &&
             data.mode in ['practice', 'daily', 'streak'] &&
             data.createdAt == request.time;
    }

    match /games/{gameId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidGameLog(request.resource.data);
    }

    // Leaderboards
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'displayName', 'score', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.score is int &&
             data.updatedAt == request.time;
    }

    match /leaderboards/{difficulty}/scores/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidLeaderboardEntry(request.resource.data);
    }
  }
}
